[16.333776, "o", "\r\n"]
[16.334461, "o", "\u001b[36m╭─\u001b[0m\u001b[36m────────────────────────────────\u001b[0m\u001b[36m \u001b[0m\u001b[1;36mStep 3 of 6 — Database Targets\u001b[0m\u001b[36m \u001b[0m\u001b[36m────────────────────────────────\u001b[0m\u001b[36m─╮\u001b[0m\r\n\u001b[36m│\u001b[0m  \u001b[2mDefine the database hosts to benchmark against.\u001b[0m                                                 \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m  \u001b[2mEach target gets its own HammerDB Job pod in Kubernetes.\u001b[0m                                        \u001b[36m│\u001b[0m\r\n\u001b[36m╰──────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[0m\r\n"]
