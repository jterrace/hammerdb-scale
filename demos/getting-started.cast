[70.799546, "o", "─────────────────────────────────┼───────────────────────────────────────────────┤ \u001b[32m│\u001b[0m\r\n\u001b[32m│\u001b[0m │\u001b[36m \u001b[0m\u001b[36mLoad VUs                                    \u001b[0m\u001b[36m \u001b[0m│ 8                                             │ \u001b[32m│\u001b[0m\r\n\u001b[32m│\u001b[0m │\u001b[36m \u001b[0m\u001b[36mRampup (min)                                \u001b[0m\u001b[36m \u001b[0m│ 1                                             │ \u001b[32m│\u001b[0m\r\n\u001b[32m│\u001b[0m │\u001b[36m \u001b[0m\u001b[36mDuration (min)                              \u001b[0m\u001b[36m \u001b[0m│ 1                                             │ \u001b[32m│\u001b[0m\r\n\u001b[32m│\u001b[0m └──────────────────────────────────────────────┴───────────────────────────────────────────────┘ \u001b[32m│\u001b[0m\r\n\u001b[32m╰──────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[0m\r\n\r\n"]
