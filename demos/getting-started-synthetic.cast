[4.937558, "o", "\u001b[34m\u256d\u2500\u001b[0m hammerdb-scale 2.0.2 \u001b[34m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[0m\r\n"]
[4.952558, "o", "\u001b[34m\u2502\u001b[0m                                                                              \u001b[34m\u2502\u001b[0m\r\n"]
[4.967558, "o", "\u001b[34m\u2502\u001b[0m  \u001b[1mHammerDB-Scale Configuration Wizard\u001b[0m                                         \u001b[34m\u2502\u001b[0m\r\n"]
[4.982558, "o", "\u001b[34m\u2502\u001b[0m                                                                              \u001b[34m\u2502\u001b[0m\r\n"]
[4.997558, "o", "\u001b[34m\u2502\u001b[0m  This wizard will guide you through creating a benchmark                     \u001b[34m\u2502\u001b[0m\r\n"]
[5.012558, "o", "\u001b[34m\u2502\u001b[0m  configuration file step by step.                                            \u001b[34m\u2502\u001b[0m\r\n"]
[5.027558, "o", "\u001b[34m\u2502\u001b[0m                                                                              \u001b[34m\u2502\u001b[0m\r\n"]
[5.042558, "o", "\u001b[34m\u2502\u001b[0m  \u001b[2mPress Ctrl+C at any time to cancel.\u001b[0m                                         \u001b[34m\u2502\u001b[0m\r\n"]
[5.057558, "o", "\u001b[34m\u2502\u001b[0m                                                                              \u001b[34m\u2502\u001b[0m\r\n"]
[5.072558, "o", "\u001b[34m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[0m\r\n"]
[6.087558, "o", "\r\n"]
[6.102558, "o", "\u001b[36m\u256d\u2500\u001b[0m \u001b[1mStep 1 of 6 \u2014 Deployment\u001b[0m \u001b[36m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[0m\r\n"]
